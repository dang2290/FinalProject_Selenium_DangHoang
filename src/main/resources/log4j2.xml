<?xml version="1.0" encoding="UTF-8"?>
<!--
  Một nguồn log cho cả framework:
  - Step    : mọi Allure step (test > Page > WebUI), cùng câu chữ với report
  - WebUI   : giá trị đọc được, điều kiện đang chờ
  - Status  : bắt đầu / kết quả từng test (hiện thêm ở console)
  Xem cả lần đọc lặp trong lúc chờ: thêm -Dlog.level=debug
-->
<Configuration status="WARN">
    <Properties>
        <Property name="log.level">info</Property>
    </Properties>
    <Appenders>
        <File name="FileAppender" fileName="reports/logs/test-execution.log" append="false">
            <PatternLayout charset="UTF-8" pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] [%X{test}] %-5level %logger{1} - %msg%n"/>
        </File>
        <Console name="ConsoleStatus" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss} %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="com.danghoang.Status" level="info" additivity="true">
            <AppenderRef ref="ConsoleStatus"/>
        </Logger>
        <Logger name="com.danghoang" level="${sys:log.level:-info}" additivity="false">
            <AppenderRef ref="FileAppender"/>
        </Logger>
        <Root level="warn">
            <AppenderRef ref="FileAppender"/>
        </Root>
    </Loggers>
</Configuration>
